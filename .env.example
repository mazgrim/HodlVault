# In produzione imposta APP_ENV=production: l'app rifiuta di partire senza una SECRET_KEY forte (>=32 char)
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
DATABASE_URL=sqlite:///./data/hodlvault.db

# App behaviour
REGISTRATION_OPEN=true
DEFAULT_CURRENCY=EUR
PRICE_UPDATE_HOUR=18

# Login brute-force lockout (protegge un'istanza esposta su internet dai bot)
LOGIN_MAX_ATTEMPTS=5            # tentativi falliti (per IP o per account) prima del blocco
LOGIN_LOCKOUT_MINUTES=15        # finestra/durata del blocco in minuti
LOGIN_ATTEMPT_RETENTION_DAYS=90 # giorni di conservazione del registro accessi

# Finance
RISK_FREE_RATE=0.03

# CORS (comma-separated origins, * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
